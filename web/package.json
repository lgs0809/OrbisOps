{
  "name": "orbisops-web",
  "version": "2.0.0",
  "description": "Web console for OrbisOps, a governed agentic operations platform.",
  "keywords": [
    "agent",
    "operations",
    "workflow",
    "mcp",
    "react"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    ".gitignore",
    "index.html",
    "package.json",
    "rsbuild.config.ts",
    "tsconfig.json"
  ],
  "dependencies": {
    "@douyinfe/semi-icons": "^2.72.3",
    "@douyinfe/semi-ui": "^2.72.3",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.10.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "styled-components": "^5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rsbuild/core": "^1.2.16",
    "@rsbuild/plugin-less": "^1.1.1",
    "@rsbuild/plugin-react": "^1.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/styled-components": "^5",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "~7.0.3",
    "jsdom": "^24.1.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rsbuild build",
    "build:fast": "rsbuild build",
    "build:watch": "rsbuild build --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "cross-env MODE=app NODE_ENV=development rsbuild dev",
    "start": "cross-env NODE_ENV=development rsbuild dev",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "capture:readme": "playwright test --config=playwright.capture.config.ts && python3 scripts/build-readme-demo-gif.py",
    "typecheck": "tsc --noEmit",
    "verify": "npm run release:hygiene && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "watch": "rsbuild build --watch",
    "release:hygiene": "node scripts/release-hygiene.mjs"
  }
}
