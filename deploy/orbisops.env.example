# OrbisOps deployment settings.
# Copy to deploy/orbisops.env, replace every [REDACTED_SECRET], and never commit deploy/orbisops.env.

ORBISOPS_VERSION=2.0.0
ORBISOPS_WEB_PORT=3002
ORBISOPS_SERVER_PORT=8099

# MySQL
ORBISOPS_MYSQL_DATABASE=orbisops
ORBISOPS_MYSQL_USERNAME=orbisops
ORBISOPS_MYSQL_PASSWORD=[REDACTED_SECRET]
ORBISOPS_MYSQL_ROOT_PASSWORD=[REDACTED_SECRET]
ORBISOPS_MYSQL_PORT=3306

# PostgreSQL / pgvector
ORBISOPS_PGVECTOR_DATABASE=orbisops
ORBISOPS_PGVECTOR_USERNAME=orbisops
ORBISOPS_PGVECTOR_PASSWORD=[REDACTED_SECRET]
ORBISOPS_PGVECTOR_PORT=5432

# Redis
ORBISOPS_REDIS_PASSWORD=[REDACTED_SECRET]
ORBISOPS_REDIS_PORT=6379

# OpenAI-compatible model service. OrbisOps does not deploy a model server.
# The control plane can boot with the placeholder values; model execution remains unavailable until configured.
ORBISOPS_MODEL_BASE_URL=https://model-provider.example.com
ORBISOPS_MODEL_API_KEY=[REDACTED_SECRET]
ORBISOPS_CHAT_MODEL=your-chat-model
ORBISOPS_EMBEDDING_BASE_URL=https://embedding-provider.example.com
ORBISOPS_EMBEDDING_API_KEY=[REDACTED_SECRET]
ORBISOPS_EMBEDDING_MODEL=your-embedding-model
ORBISOPS_EMBEDDING_DIMENSIONS=1536

# Optional rerank service. Disabled unless explicitly enabled.
ORBISOPS_RERANK_ENABLED=false
ORBISOPS_RERANK_PROVIDER=openai-compatible
ORBISOPS_RERANK_BASE_URL=https://rerank-provider.example.com
ORBISOPS_RERANK_API_KEY=[REDACTED_SECRET]
ORBISOPS_RERANK_MODEL=your-rerank-model

# Authentication. Replace before startup.
ORBISOPS_ADMIN_JWT_SECRET=[REDACTED_SECRET]
ORBISOPS_ADMIN_SERVICE_TOKEN=[REDACTED_SECRET]

# Optional headless administrator bootstrap for automated deployments.
# Normal first-time setup is completed in the browser; keep this disabled unless explicitly needed.
ORBISOPS_BOOTSTRAP_ADMIN_ENABLED=false
ORBISOPS_BOOTSTRAP_ADMIN_USER_ID=
ORBISOPS_BOOTSTRAP_ADMIN_USERNAME=
ORBISOPS_BOOTSTRAP_ADMIN_PASSWORD=[REDACTED_SECRET]
