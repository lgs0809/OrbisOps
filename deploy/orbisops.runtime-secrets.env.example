# Optional runtime-only secrets for database-backed runtime configuration.
#
# Copy this file to deploy/orbisops.runtime-secrets.env when a Project/Model/MCP
# configuration uses an environment reference such as ${env:PROJECT_MYSQL_PASSWORD}.
# The runtime-secrets file is gitignored and is loaded only into the backend container.
#
# Use your own environment-variable names; these are examples only.
PROJECT_MYSQL_PASSWORD=replace-me
PROJECT_RABBITMQ_PASSWORD=replace-me
CUSTOM_MODEL_API_KEY=replace-me
