{
  "agentId": "ops-business-inspection-a",
  "schemaVersion": 1,
  "name": "A · 服务巡检与异常调查",
  "projectId": "ops-acceptance-a",
  "engine": "HYBRID",
  "description": "自然语言入口，内部解析授权目标；必要信息缺失时自然追问。固定最近 5 分钟巡检，100 请求、1% 错误率、1 秒 p95；异常或不可达携带已采集证据进入固定版本 B 的有界只读调查，再汇总原巡检结论和子运行依据。样本不足不进入调查，模型阶段仍以 B 已发布能力为限。",
  "instruction": "固定规则判断已接入指标；无数据和样本不足不可判健康，异常交由有界告警调查继续。",
  "definitionKind": "SPECIALIZED_WORKFLOW",
  "workflowInvocationMode": "MANUAL_ONLY",
  "workflowAutoSelectEnabled": false,
  "queryRewriteEnabled": false,
  "ragEnabled": false,
  "startNodeId": "start",
  "nodes": [
    {
      "nodeId": "start",
      "type": "START",
      "config": {
        "inputKeys": [
          "query"
        ],
        "maxRealToolCalls": 12,
        "position": {
          "x": 40,
          "y": 40
        }
      }
    },
    {
      "nodeId": "resolve_request",
      "type": "AGENT",
      "mode": "REACT",
      "agent": "ops-request-resolver",
      "modelId": "ops-acceptance-luna",
      "outputKey": "resolvedRequest",
      "mcpIds": [
        "$observabilityMcpId"
      ],
      "instruction": "你是工作流内部的输入解析节点。用户只需要自然语言。根据原始问题、可信项目上下文与已授权资源目录识别目标；必须先读取相关 MCP 工具的完整参数说明（enable_mcp_tool），核对 schema 中项目、环境、服务的准确取值，再决定是否缺信息；压缩工具目录尚未显示字段，不代表字段不可发现。授权 schema 对某个必填字段只有一个合法候选时自动使用它，不得再向用户询问；通过名称映射唯一匹配的服务也自动使用。只有完整说明仍显示多个无法区分的实际候选时才询问。不要执行业务查询或任何写操作。不得根据主机名猜项目 ID，不得把用户声明当作授权。只输出符合下方 JSON Schema 的 JSON 对象，不加代码围栏；这是系统内部输出，不让用户填写字段。信息足够则 status=READY；确实无法唯一确定目标才 status=NEED_INFO 并给出简短自然语言 question，询问服务名称或现象，不索要 JSON 或内部 ID。这是巡检，只需确定项目、环境、服务；最近五分钟窗口由后续确定性规则生成，不让用户给时间戳。输出契约：{\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"string\", \"enum\": [\"READY\", \"NEED_INFO\"]}, \"projectId\": {\"type\": \"string\"}, \"environment\": {\"type\": \"string\"}, \"serviceId\": {\"type\": \"string\"}, \"question\": {\"type\": \"string\"}, \"alertTime\": {\"type\": \"string\"}, \"alertContent\": {\"type\": \"string\"}}, \"additionalProperties\": false, \"oneOf\": [{\"properties\": {\"status\": {\"const\": \"READY\"}}, \"required\": [\"status\", \"projectId\", \"environment\", \"serviceId\"]}, {\"properties\": {\"status\": {\"const\": \"NEED_INFO\"}}, \"required\": [\"status\", \"question\"]}]}",
      "description": "理解自然语言并在内部匹配授权资源；真正缺信息时自然追问",
      "config": {
        "inheritProjectCapabilities": true,
        "outputContract": {
          "format": "JSON",
          "schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "READY",
                  "NEED_INFO"
                ]
              },
              "projectId": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "serviceId": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "alertTime": {
                "type": "string"
              },
              "alertContent": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "READY"
                  }
                },
                "required": [
                  "status",
                  "projectId",
                  "environment",
                  "serviceId"
                ]
              },
              {
                "properties": {
                  "status": {
                    "const": "NEED_INFO"
                  }
                },
                "required": [
                  "status",
                  "question"
                ]
              }
            ]
          }
        },
        "position": {
          "x": 40,
          "y": -280
        }
      }
    },
    {
      "nodeId": "route_request",
      "type": "ROUTER",
      "config": {
        "inputKey": "resolvedRequest",
        "inputFormat": "JSON",
        "routeMode": "single",
        "position": {
          "x": 390,
          "y": -280
        }
      },
      "agent": "ops-observability-rules"
    },
    {
      "nodeId": "clarify_request",
      "type": "ROUTER",
      "description": "向用户显示自然语言追问",
      "config": {
        "inputKey": "question",
        "routeMode": "single",
        "position": {
          "x": 740,
          "y": -280
        }
      },
      "agent": "ops-observability-rules"
    },
    {
      "nodeId": "window",
      "type": "ROUTER",
      "agent": "ops-observability-rules",
      "description": "冻结最近 5 分钟的实际巡检窗口",
      "config": {
        "observability": {
          "operation": "WINDOW_INSPECTION",
          "outputKey": "window"
        },
        "routeMode": "single",
        "position": {
          "x": 390,
          "y": 40
        },
        "requestInputKey": "resolvedRequest"
      }
    },
    {
      "nodeId": "metrics",
      "type": "AGENT",
      "mode": "DIRECT",
      "agent": "ops-observability-reader",
      "mcpIds": [
        "$observabilityMcpId"
      ],
      "description": "采集真实 Prometheus 计数器、up 和直方图",
      "config": {
        "actions": [
          {
            "mcpId": "$observabilityMcpId",
            "remoteToolName": "metrics_window",
            "argumentBindings": {
              "window": "nodeOutput.workflowData_window.queryScope"
            },
            "structuredOutputKey": "metrics",
            "outputMode": "MCP_EVIDENCE_REFERENCE"
          }
        ],
        "position": {
          "x": 740,
          "y": 40
        }
      }
    },
    {
      "nodeId": "review",
      "type": "ROUTER",
      "agent": "ops-observability-rules",
      "description": "按样本、绝对 SLO 与 up 判定；只有异常或不可达进入 B",
      "config": {
        "observability": {
          "operation": "REVIEW_INSPECTION",
          "outputKey": "report",
          "windowKey": "window",
          "metricsKey": "metrics",
          "logsKey": "logs",
          "sqlKey": "sql",
          "explainKey": "explain"
        },
        "routeMode": "single",
        "position": {
          "x": 390,
          "y": 240
        }
      }
    },
    {
      "nodeId": "handoff",
      "type": "ROUTER",
      "agent": "ops-observability-rules",
      "description": "携带原五分钟报告和证据引用，冻结调查告警时间",
      "config": {
        "observability": {
          "operation": "ALERT_FROM_INSPECTION",
          "outputKey": "alertInput",
          "reportKey": "report"
        },
        "routeMode": "single",
        "position": {
          "x": 740,
          "y": 240
        }
      }
    },
    {
      "nodeId": "investigate",
      "type": "SUB_WORKFLOW",
      "agent": "ops-business-alert-b",
      "description": "执行固定发布版本 B；按不同告警窗口查询，真实派发含重试最多 12 次",
      "config": {
        "versionPolicy": "PINNED_VERSION",
        "version": "$alertWorkflowVersion",
        "inputKey": "workflowData_alertInput",
        "structuredOutputKey": "investigation",
        "position": {
          "x": 740,
          "y": 480
        }
      }
    },
    {
      "nodeId": "summary",
      "type": "ROUTER",
      "agent": "ops-observability-rules",
      "description": "保留原巡检判定，附 B 子运行结果、证据与未完成观察窗口",
      "config": {
        "observability": {
          "operation": "SUMMARIZE_INSPECTION",
          "outputKey": "report",
          "reportKey": "report",
          "investigationKey": "investigation"
        },
        "routeMode": "single",
        "position": {
          "x": 390,
          "y": 480
        }
      }
    },
    {
      "nodeId": "end",
      "type": "END",
      "config": {
        "outputKeys": [
          "workflowData_report"
        ],
        "position": {
          "x": 40,
          "y": 720
        }
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "resolve_request",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "window",
      "to": "metrics",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "metrics",
      "to": "review",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "review",
      "to": "handoff",
      "conditionType": "expression",
      "condition": "nodeOutput.workflowData_report.status == \"UNHEALTHY\" || nodeOutput.workflowData_report.status == \"UNREACHABLE\""
    },
    {
      "from": "review",
      "to": "end",
      "conditionType": "default",
      "condition": "default"
    },
    {
      "from": "handoff",
      "to": "investigate",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "investigate",
      "to": "summary",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "summary",
      "to": "end",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "resolve_request",
      "to": "route_request",
      "conditionType": "always",
      "condition": "always"
    },
    {
      "from": "route_request",
      "to": "window",
      "conditionType": "expression",
      "condition": "nodeOutput.status == \"READY\""
    },
    {
      "from": "route_request",
      "to": "clarify_request",
      "conditionType": "default",
      "condition": "default"
    },
    {
      "from": "clarify_request",
      "to": "end",
      "conditionType": "always",
      "condition": "always"
    }
  ]
}
