# Copy the values into your deployment environment. Do not commit real credentials.
SERVER_PORT=8099
SPRING_PROFILES_ACTIVE=prod

MYSQL_URL=jdbc:mysql://127.0.0.1:3306/orbisops?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=orbisops
MYSQL_PASSWORD=[REDACTED_SECRET]

PGVECTOR_URL=jdbc:postgresql://127.0.0.1:5432/orbisops
PGVECTOR_USERNAME=orbisops
PGVECTOR_PASSWORD=[REDACTED_SECRET]

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=[REDACTED_SECRET]

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=[REDACTED_SECRET]
OPENAI_CHAT_MODEL=your-chat-model

OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:8110
OPENAI_EMBEDDING_API_KEY=[REDACTED_SECRET]
OPENAI_EMBEDDING_MODEL=your-embedding-model
OPENAI_EMBEDDING_DIMENSIONS=2048

ADMIN_JWT_SECRET=[REDACTED_SECRET]
ADMIN_SERVICE_TOKEN=[REDACTED_SECRET]

# Disabled by default. Enable only for first-run administrator creation, then disable it.
ORBISOPS_BOOTSTRAP_ADMIN_ENABLED=false
ORBISOPS_BOOTSTRAP_ADMIN_USER_ID=bootstrap-admin
ORBISOPS_BOOTSTRAP_ADMIN_USERNAME=your-admin-name
ORBISOPS_BOOTSTRAP_ADMIN_PASSWORD=[REDACTED_SECRET]

ORBISOPS_TASK_JOB_ENABLED=true
ORBISOPS_TASK_POOL_SIZE=5
